# Open AI
RAG_LLM_API_KEY=""
RAG_LLM_BASE_URL=""
# Chat model name your endpoint serves (e.g. gpt-4o-mini, deepseek-v4-pro).
# REQUIRED when RAG_LLM_BASE_URL points anywhere other than api.openai.com —
# without it the pipeline falls back to gpt-4o-mini, which DeepSeek and most
# other endpoints reject with a 400 error.
LLM_MODEL=""
# max_tokens: default 16000; set to 8192 if using deepseek
RAG_LLM_MAX_TOKENS=""

# Image Generation
# provider: openrouter (default) or google
IMAGE_GEN_PROVIDER="openrouter"
IMAGE_GEN_API_KEY=""
IMAGE_GEN_BASE_URL=""
IMAGE_GEN_MODEL=""
IMAGE_GEN_RESPONSE_MIME_TYPE="image/png"
GOOGLE_GENAI_BASE_URL=""
