# Open AI
RAG_LLM_API_KEY=""
RAG_LLM_BASE_URL=""
# max_tokens: default 16000; set to 8192 if using deepseek
RAG_LLM_MAX_TOKENS=""

# Local LLM (OpenAI-compatible servers: Ollama, LM Studio, vLLM, llama.cpp, SGLang)
# Example (Ollama):
#   RAG_LLM_BASE_URL="http://localhost:11434/v1"
#   LLM_MODEL="qwen2.5:14b"
#   EMBEDDING_MODEL="nomic-embed-text"
#   EMBEDDING_DIM="768"
# Example (LM Studio):
#   RAG_LLM_BASE_URL="http://localhost:1234/v1"
# Example (vLLM / llama.cpp server):
#   RAG_LLM_BASE_URL="http://localhost:8000/v1"
# Notes:
# - RAG_LLM_API_KEY can stay empty for local servers (any non-empty string works if required)
# - Fast mode (--fast) sends document images to the LLM: use a vision model (e.g. llama3.2-vision, qwen2.5-vl)
# - Image generation (slides/poster rendering) always needs a real image-capable model via IMAGE_GEN_*

# Model overrides (defaults: LLM_MODEL=gpt-4o-mini, EMBEDDING_MODEL=text-embedding-3-large, EMBEDDING_DIM=3072)
LLM_MODEL=""
EMBEDDING_MODEL=""
EMBEDDING_DIM=""

# Image Generation
# provider: openrouter (default) or google
IMAGE_GEN_PROVIDER="openrouter"
IMAGE_GEN_API_KEY=""
IMAGE_GEN_BASE_URL=""
IMAGE_GEN_MODEL=""
IMAGE_GEN_RESPONSE_MIME_TYPE="image/png"
GOOGLE_GENAI_BASE_URL=""